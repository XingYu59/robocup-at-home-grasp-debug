    <!--
      可抓/可动物体：通过 include 引用包内 model.sdf，避免与资源定义双份维护。
      name 仅为 Gazebo 仿真侧实例标识；机器人侧不会收到模型名或几何。
    -->
    <include>
      <uri>model://apple</uri>
      <name>apple_clone_0</name>
      <pose>-2.04956 0.051327 0.78 -0.009228 0.006638 0.019539</pose>
    </include>
    <include>
