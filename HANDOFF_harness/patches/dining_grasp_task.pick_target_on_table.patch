+    def _gz_model_names(self):
+        """列出世界里的模型名（仿真专用）。用来找"餐桌上已经有的物体"。"""
+        exe = "ign" if shutil.which("ign") else ("gz" if shutil.which("gz") else None)
+        if exe is None:
+            return []
+        try:
+            out = subprocess.run([exe, "model", "--list"],
+                                 capture_output=True, text=True, timeout=5)
+        except Exception:
+            return []
+        if out.returncode != 0:
+            return []
+        # 输出形如：
+        #   Available models:
+        #       - ground_plane
+        #       - coke_can_1
+        names = []
+        for line in out.stdout.splitlines():
+            line = line.strip()
+            if line.startswith("- "):
+                names.append(line[2:].strip())
+        return names
+
+    @staticmethod
+    def _class_of_model(model_name):
+        """模型名 → 类别名；不属于词表返回 None（coke_can_1 / apple_clone_0 也认）。"""
+        for prefix, cls in MODEL_PREFIX_TO_CLASS.items():
+            if model_name == prefix or model_name.startswith(prefix + "_"):
+                return cls
+        return None
+
+    def pick_target_on_table(self, explicit_name=None, explicit_class=None):
+        """从【餐桌上已经存在的物体】里挑一个抓取目标。
+
+        规则书要求"从桌上四个物品里任选一个"，所以目标在运行时决定：
+          1. 列出世界里的模型 → 认得出类别的（coke can / apple / bowl / banana）
+          2. 位姿落在餐桌桌面范围内、且高度≈桌面 → 才算"桌上的物体"
+          3. 去掉夹不住的类别（GRASPABLE_CLASSES）→ 按 TARGET_PREFERENCE 的类序，
+             同类里挑离机器人这一侧桌沿最近的（站得越靠边越好抓）
+        返回 (name, cls, x, y) 或 None；同时把结果记到 self.target_*。
+        """
+        robot = self._gz_model_pose(ROBOT_MODEL_NAME)
+        cands = []
+        for name in self._gz_model_names():
+            cls = explicit_class if (explicit_name and name == explicit_name) else self._class_of_model(name)
+            if cls is None:
+                continue
+            if explicit_name and name != explicit_name:
+                continue
+            if explicit_class and cls != explicit_class:
+                continue
+            pose = self._gz_model_pose(name)
+            if pose is None:
+                continue
+            x, y, z = pose[0], pose[1], pose[2]
+            on_table = (abs(x - TABLE_CENTER_XYZ[0]) <= TABLE_HALF_X
+                        and abs(y - TABLE_CENTER_XYZ[1]) <= TABLE_HALF_Y)
+            if not on_table:
+                continue
+            if not GRASPABLE_CLASSES.get(cls, False):
+                self.get_logger().warn(
+                    "桌上物体 \"{}\"（{}）不可夹（见 objects.yaml graspable=false），跳过"
+                    .format(name, cls))
+                continue
+            if robot is not None and math.hypot(x - robot[0], y - robot[1]) < 0.15:
+                continue            # 太近的多半是机器人自己身上带的东西
+            cands.append({"name": name, "cls": cls, "x": x, "y": y, "z": z})
+
+        if not cands:
+            return None
+
+        def rank(c):
+            pref = TARGET_PREFERENCE.index(c["cls"]) if c["cls"] in TARGET_PREFERENCE else 99
+            return (pref, -(c["y"]))      # 同类里 y 越大越靠机器人这一侧
+
+        cands.sort(key=rank)
+        best = cands[0]
+        self.target_name = best["name"]
+        self.target_class = best["cls"]
+        self.target_src_xyz = (best["x"], best["y"], TABLE_TOP_Z)
+        self.get_logger().info(
+            "餐桌上可抓的物体 {} 个：{}；选 \"{}\"（{}）@ map({:.3f}, {:.3f})".format(
+                len(cands), [(c["name"], c["cls"]) for c in cands],
+                best["name"], best["cls"], best["x"], best["y"]))
+        return best["name"], best["cls"], best["x"], best["y"]
+
+    def table_objects(self):
+        """列出【餐桌上所有认得出类别的物体】（目标 + 障碍都要用）。"""
+        out = []
+        for name in self._gz_model_names():
+            cls = self._class_of_model(name)
+            if cls is None:
+                continue
+            pose = self._gz_model_pose(name)
+            if pose is None:
+                continue
+            x, y = pose[0], pose[1]
+            if (abs(x - TABLE_CENTER_XYZ[0]) <= TABLE_HALF_X
+                    and abs(y - TABLE_CENTER_XYZ[1]) <= TABLE_HALF_Y):
+                out.append({"name": name, "cls": cls, "x": x, "y": y})
+        return out
