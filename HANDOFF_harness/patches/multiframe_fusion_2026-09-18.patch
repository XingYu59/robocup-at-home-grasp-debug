+    def _grab_frame(self, last_key, timeout=None):
+        """取一帧数据（RGB+深度+内参三路一起），要求 RGB 的 stamp 与 last_key 不同。
+
+        ★ 多帧投票的前提：只有"换了 stamp"才算新帧 —— 模型是确定性的，
+          同一张图推理 N 遍结果逐位相同，那不是投票 ✗（2026-09-18 修复的根因）。
+        等不到新帧（仿真暂停等）就退回最新一帧，fresh=False，由调用方决定告警。
+        返回 (img, depth_msg, info, key, fresh)；三路凑不齐时 img=None。
+        """
+        timeout = self.stream_timeout if timeout is None else timeout
+        deadline = time.time() + timeout
+        img = dep = info = None
+        fresh = False
+        key = last_key
+        while rclpy.ok() and time.time() < deadline:
+            with self._lock:
+                img, dep, info = self._img, self._depth, self._info
+            if (img is not None and dep is not None and info is not None
+                    and self._fresh_enough(img) and self._fresh_enough(dep)
+                    and self._fresh_enough(info)):
+                key = (img.header.stamp.sec, img.header.stamp.nanosec)
+                if key != last_key:
+                    fresh = True
+                    break
+            time.sleep(0.05)
+        if img is None or dep is None or info is None:
+            return None, None, None, last_key, False
+        return img, dep, info, key, fresh
+
